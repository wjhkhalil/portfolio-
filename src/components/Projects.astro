---
import { Image } from 'astro:assets';
import { projects } from '../data/profile';
---

<section class="section projects-section" id="work">
  <div class="container">
    <span class="section-label reveal">Selected work</span>
    <h2 class="section-title reveal">Things I've built</h2>
    <p class="section-intro reveal">
      A look at the problem behind each project, the decisions I made, and how it turned out.
    </p>

    {
      projects.map((project) => (
        <article class="project reveal">
          <div class="info">
            {project.status && <p class="pill">{project.status}</p>}

            <h3>{project.name}</h3>
            <p class="tagline">{project.tagline}</p>
            <p class="description">{project.summary}</p>

            <ul class="features">
              {project.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>

            <ul class="tech" aria-label="Technologies used">
              {project.tech.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>

            <div class="actions">
              <a class="btn btn-primary" href={`/projects/${project.slug}/`}>
                Read the case study
              </a>
              {project.links.playStore && (
                <a class="btn btn-outline" href={project.links.playStore} target="_blank" rel="noopener">
                  Google Play
                </a>
              )}
              {project.links.github && (
                <a class="btn btn-outline" href={project.links.github} target="_blank" rel="noopener">
                  Source code
                </a>
              )}
            </div>
          </div>

          <div class="shots">
            {project.screenshots.map((shot) => (
              <Image src={shot.src} alt={shot.alt} widths={[240, 480]} sizes="(max-width: 760px) 45vw, 200px" />
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects-section {
    background: var(--surface-soft);
  }

  .project {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
    padding: clamp(24px, 5vw, 48px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 8px);
    box-shadow: var(--shadow);
  }

  .project + .project {
    margin-top: 32px;
  }

  .pill {
    margin-bottom: 16px;
  }

  h3 {
    font-size: clamp(1.8rem, 4vw, 2.3rem);
  }

  .tagline {
    color: var(--accent);
    font-weight: 500;
    margin-top: 4px;
  }

  .description {
    color: var(--muted);
    margin-top: 16px;
  }

  .features {
    margin: 20px 0 0;
    padding-left: 20px;
    color: var(--muted);
  }

  .features li::marker {
    color: var(--accent);
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .shots {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .shots img {
    width: 100%;
    border-radius: 18px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    transition: transform 0.3s ease;
  }

  .shots img:nth-child(even) {
    margin-top: 32px;
  }

  .shots img:hover {
    transform: translateY(-4px);
  }

  @media (max-width: 860px) {
    .project {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shots img:hover {
      transform: none;
    }
  }
</style>
