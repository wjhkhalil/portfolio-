---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { projects, profile } from '../../data/profile';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const hasLinks = project.links.playStore || project.links.github || project.links.demo;
---

<Layout
  title={`${project.name} — a case study by ${profile.name}`}
  description={project.summary}
  type="article"
>
  <Header />

  <main id="main">
    <article>
      <header class="head container">
        <a class="back" href="/#work">
          <Icon name="arrow-left" size={18} />
          Back to all work
        </a>

        {project.status && <p class="pill">{project.status}</p>}

        <h1>{project.name}</h1>
        <p class="tagline">{project.tagline}</p>
        <p class="summary">{project.summary}</p>

        <ul class="tech" aria-label="Technologies used">
          {project.tech.map((item) => <li class="tag">{item}</li>)}
        </ul>

        {
          hasLinks && (
            <div class="actions">
              {project.links.playStore && (
                <a class="btn btn-primary" href={project.links.playStore} target="_blank" rel="noopener">
                  Get it on Google Play
                </a>
              )}
              {project.links.demo && (
                <a class="btn btn-outline" href={project.links.demo} target="_blank" rel="noopener">
                  Live demo
                </a>
              )}
              {project.links.github && (
                <a class="btn btn-outline" href={project.links.github} target="_blank" rel="noopener">
                  Source code
                </a>
              )}
            </div>
          )
        }
      </header>

      <section class="gallery-section">
        <div class="container gallery">
          {
            project.screenshots.map((shot) => (
              <figure class="reveal">
                <Image src={shot.src} alt={shot.alt} widths={[280, 560]} sizes="(max-width: 760px) 45vw, 240px" />
                <figcaption>{shot.alt}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <div class="container body">
        <section class="block reveal">
          <span class="section-label">The problem</span>
          <h2>Why I built it</h2>
          <p>{project.problem}</p>
        </section>

        <section class="block reveal">
          <span class="section-label">The build</span>
          <h2>What I did</h2>
          <ol class="steps">
            {project.approach.map((step) => <li>{step}</li>)}
          </ol>
        </section>

        <section class="block reveal">
          <span class="section-label">The result</span>
          <h2>How it turned out</h2>
          <p>{project.result}</p>

          <ul class="features">
            {project.features.map((feature) => <li>{feature}</li>)}
          </ul>
        </section>

        <aside class="next reveal">
          <h2>Want something like this?</h2>
          <p>
            If you have an app idea — or a half-finished one — tell me about it and I will let you know
            what it would take.
          </p>
          <a class="btn btn-primary" href="/#contact">Start a project</a>
        </aside>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .head {
    padding-block: clamp(40px, 7vw, 72px) clamp(32px, 5vw, 48px);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: none;
    margin-bottom: 28px;
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--accent);
  }

  .pill {
    margin-bottom: 18px;
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 3.8rem);
    letter-spacing: -0.02em;
  }

  .tagline {
    margin-top: 8px;
    color: var(--accent);
    font-size: 1.2rem;
    font-weight: 500;
  }

  .summary {
    margin-top: 20px;
    max-width: 62ch;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .gallery-section {
    padding-block: clamp(32px, 5vw, 56px);
    background: var(--surface-soft);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px;
  }

  .gallery figure {
    margin: 0;
  }

  .gallery img {
    width: 100%;
    border-radius: 18px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  .gallery figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .body {
    max-width: 760px;
    padding-block: clamp(48px, 8vw, 88px);
  }

  .block + .block {
    margin-top: clamp(40px, 6vw, 64px);
  }

  .block h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
    margin-bottom: 18px;
  }

  .block p {
    color: var(--muted);
    font-size: 1.08rem;
  }

  .steps {
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: 20px;
  }

  .steps li {
    position: relative;
    padding-left: 52px;
    color: var(--muted);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.92rem;
    font-weight: 600;
    font-family: var(--font-body);
  }

  .features {
    margin: 24px 0 0;
    padding-left: 20px;
    color: var(--muted);
  }

  .features li::marker {
    color: var(--accent);
  }

  .next {
    margin-top: clamp(48px, 7vw, 80px);
    padding: clamp(28px, 5vw, 44px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .next h2 {
    font-size: clamp(1.5rem, 3.2vw, 2rem);
  }

  .next p {
    max-width: 46ch;
    margin: 14px auto 26px;
    color: var(--muted);
  }
</style>
